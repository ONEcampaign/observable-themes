{
  "name": "@one-data/observable-themes",
  "version": "0.9.3",
  "type": "module",
  "description": "Modular CSS, React components, and utilities for Observable Framework projects",
  "main": "styles/index.css",
  "exports": {
    ".": {
      "import": "./styles/index.css"
    },
    "./styles/*": "./styles/*",
    "./inputs": "./dist/inputs.js",
    "./inputs/*": "./inputs/*",
    "./charts": "./dist/charts.js",
    "./charts/*": "./charts/*",
    "./ui": "./dist/ui.js",
    "./ui/*": "./ui/*",
    "./utils": "./utils/index.js",
    "./utils/*": "./utils/*",
    "./colors": "./colors/index.js",
    "./colors/*": "./colors/*",
    "./brand": "./brand/index.js"
  },
  "files": [
    "assets/images/",
    "assets/fonts/",
    "styles",
    "dist/",
    "inputs/",
    "charts/",
    "ui/",
    "utils/",
    "colors/",
    "brand/"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build",
    "docs:dev": "cd preview && npm run dev",
    "docs:build": "cd preview && npm run build"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "keywords": [
    "css",
    "Observable Framework",
    "observable",
    "ui kit",
    "design system",
    "react",
    "components"
  ],
  "contributors": [
    {
      "name": "Jorge Rivera"
    },
    {
      "name": "Miguel Haro Ruiz"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ONEcampaign/observable-themes"
  }
}
